# Editor configuration, see http://editorconfig.org
root = true

[*]
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
charset = utf-8
indent_style = space
indent_size = 2

[*.md]
max_line_length = off
trim_trailing_whitespace = false
indent_size = unset

[*.py]
indent_size = 4

[*.sh]
indent_style = space
indent_size = 4
binary_next_line = true
switch_case_indent = true
space_redirects = false
keep_padding = true
